# ─────────────────────────────────────────────────────────
# AEGIS-AI Framework — Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────

# Django
SECRET_KEY=change-this-to-a-random-string

# ── AI Providers ──────────────────────────────────────────
# Primary AI provider (gemini, groq, anthropic, deepseek)
AI_PROVIDER=gemini

# Gemini (primary) — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq (free fallback) — get key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Anthropic (optional)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Metasploit RPC ───────────────────────────────────────
METASPLOIT_HOST=localhost
METASPLOIT_PORT=55553
METASPLOIT_PASS=aegis123
